# Shared by docker-compose, the Spring API, etl/, and visualizations/.

# Shared connection (Postgres container; docker-compose maps host 8100 -> 5432)
DB_HOST=localhost
DB_PORT=8100
DB_USER=postgres
DB_PASSWORD=your_password_here

# Databases
DB_OPERATIONAL_NAME=leapfrogsdb
DB_ANALYTICS_NAME=leap_analytics

# Used by visualizations/insights-viz.py (reads the analytics DB)
POSTGRES_DB=leap_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
