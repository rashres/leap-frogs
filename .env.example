# Shared by docker-compose, etl/, and visualizations/.
# Copy to .env in this directory (gitignored).

DB_USER=your_db_user
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Kafka (trade.executed events) configuration. Used by leap-frogs and visualizations.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRADE_EXECUTED=trade.executed